[Unit]
Description=Training Manager frontend — fetch runtime config from AWS SSM into nginx snippet
# network-online + clock (SigV4), and nginx (the script does `nginx -t` + reload).
After=network-online.target nginx.service
Wants=network-online.target

[Service]
# oneshot + RemainAfterExit: fetch at boot then stay "active (exited)". A code
# deploy does NOT restart this unit by itself; the deploy restarts it to apply an
# SSM rotation. Manual restart: sudo systemctl restart tm-frontend-runtime-fetch
Type=oneshot
RemainAfterExit=yes
User=root

# Force auth via the EC2 instance role (foxugly-fleet-ec2) over IMDS by blanking the
# credentials/config files — otherwise root's static certbot-route53 keys in
# /root/.aws would shadow the role. The frontend config is public String, so no
# kms:Decrypt is needed.
Environment=AWS_SHARED_CREDENTIALS_FILE=/dev/null
Environment=AWS_CONFIG_FILE=/dev/null
Environment=AWS_REGION=eu-west-1

# §3.10: runs as root → the script lives OUTSIDE the django-writable tree
# (/usr/local/sbin, root:root 0755; installed by the deploy from the committed
# git blob). A change to the repo's source script has NO root effect until the
# pipeline reinstalls it as root — that closes the django→root path.
PrivateTmp=yes
ProtectSystem=full
ReadWritePaths=/etc/nginx/snippets
ProtectHome=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes
TimeoutStartSec=120

ExecStart=/usr/local/sbin/tm-frontend-runtime-fetch.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
