.claude/scheduled_tasks.lock
.playwright-mcp/

# Playwright e2e
/e2e/.auth/
/playwright-report/
/test-results/
/blob-report/

# System files
.DS_Store
Thumbs.db

# stray local sqlite
db.sqlite3

# Secrets : `.env` seul ne couvre que le nom exact. Un `.env.e2e-backup`
# porteur de SECRET_KEY / DB_PASSWORD a ete trouve non ignore sur
# trainingmanager_server le 2026-07-31 — un `git add -A` l'aurait commite.
.env
.env.*
